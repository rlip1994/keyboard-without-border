# Copiá este archivo a ".env" y completalo. El archivo .env NO debe subirse a git.
# Contraseña compartida (obligatoria, idéntica en las dos compus). Usá algo largo y aleatorio.
TECLADO_CLAVE=cambia-esta-clave
# Puerto UDP (opcional, por defecto 50505)
TECLADO_PUERTO=50505
# IP de la PC grande si el autodescubrimiento falla (opcional, ej. 192.168.1.50)
TECLADO_IP_PC=
